+++ b/CMakeLists.txt
@@ -166,18 +166,19 @@ message("TGFX_ENABLE_STENCIL_COVER_PATH: ${TGFX_ENABLE_STENCIL_COVER_PATH}")
 if (NOT CMAKE_OSX_DEPLOYMENT_TARGET)
     if (DEPLOYMENT_TARGET)
         set(CMAKE_OSX_DEPLOYMENT_TARGET ${DEPLOYMENT_TARGET})
-    elseif (MACOS)
-        if (CMAKE_SYSTEM_PROCESSOR STREQUAL "aarch64")
-            set(CMAKE_OSX_DEPLOYMENT_TARGET "11.0")
-        else ()
-            set(CMAKE_OSX_DEPLOYMENT_TARGET "10.15")
-        endif ()
     elseif (IOS)
+        # Includes Mac Catalyst (toolchain sets IOS=ON and MACOS=ON).
         if (TGFX_USE_METAL)
             set(CMAKE_OSX_DEPLOYMENT_TARGET "13.0")
         else ()
             set(CMAKE_OSX_DEPLOYMENT_TARGET "9.0")
         endif ()
+    elseif (MACOS)
+        if (CMAKE_SYSTEM_PROCESSOR STREQUAL "aarch64")
+            set(CMAKE_OSX_DEPLOYMENT_TARGET "11.0")
+        else ()
+            set(CMAKE_OSX_DEPLOYMENT_TARGET "10.15")
+        endif ()
     endif ()
 endif ()
 
@@ -453,7 +454,7 @@ if (TGFX_USE_QT)
 
     file(GLOB_RECURSE GPU_PLATFORM_FILES src/gpu/opengl/qt/*.*)
     list(APPEND TGFX_FILES ${GPU_PLATFORM_FILES})
-    if (MACOS)
+    if (MACOS AND NOT IOS)
         file(GLOB CGL_PLATFORM_FILES src/gpu/opengl/cgl/CGLHardwareTexture.mm)
         list(APPEND TGFX_FILES ${CGL_PLATFORM_FILES})
         list(APPEND TGFX_DEFINES GL_SILENCE_DEPRECATION)
@@ -566,6 +567,8 @@ elseif (OHOS)
         list(APPEND TGFX_FILES ${GPU_PLATFORM_FILES})
     endif ()
 elseif (IOS)
+    # iOS device/simulator and Mac Catalyst (UIKit). When both IOS and MACOS are
+    # ON (MAC_CATALYST*), take this branch — not the native macOS/Cocoa branch.
     # finds all required platform libraries.
     find_library(UIKit_LIBS UIKit REQUIRED)
     list(APPEND TGFX_SHARED_LIBS ${UIKit_LIBS})
