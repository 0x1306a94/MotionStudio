+// Mac Catalyst: UIKit-on-Mac (ios-macabi). Uses ios.toolchain MAC_CATALYST_*.
+class CatalystCMake extends AppleCMake {
+    constructor(platform) {
+        super(platform);
+        this.toolchain = path.resolve(__dirname, "../ios.toolchain.cmake");
+    }
+
+    getPlatformArgs(arch) {
+        let args = [
+            "-DCMAKE_TOOLCHAIN_FILE=" + EscapePath(this.toolchain)
+        ];
+        if (arch === "x64") {
+            args.push("-DPLATFORM=MAC_CATALYST");
+        } else {
+            // Default / arm64 → Apple Silicon Catalyst
+            args.push("-DPLATFORM=MAC_CATALYST_ARM64");
+        }
+        return args;
+    }
+}
