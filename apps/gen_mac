#!/bin/bash

SCRIPT_DIR=$(realpath $(dirname $0))
PROJECT_DIR=$(realpath $SCRIPT_DIR/..)
GEN_XCODE_PROJEC_DIR=$SCRIPT_DIR/gen_xcode
GEN_XCODE_PROJEC_FILE=$GEN_XCODE_PROJEC_DIR/MotionStudio.xcodeproj/project.pbxproj

echo "[*] SCRIPT_DIR: ${SCRIPT_DIR}"

rm -rf $GEN_XCODE_PROJEC_DIR/CMakeFiles
rm -rf $GEN_XCODE_PROJEC_DIR/CMakeScripts
rm -rf $GEN_XCODE_PROJEC_DIR/CMakeCache.txt
rm -rf $GEN_XCODE_PROJEC_DIR/cmake_install.cmake

echo "[*] Generating Xcode (SDKROOT=auto, arm64 only) ..."

# Mac runs as Mac Catalyst (SUPPORTS_MACCATALYST); no native macosx destination.
cmake -G Xcode \
-B $GEN_XCODE_PROJEC_DIR \
-DCMAKE_BUILD_TYPE=RelWithDebInfo \
-DMOTIONSTUDIO_SUPPORTED_PLATFORMS="iphoneos iphonesimulator" \
-DMOTIONSTUDIO_ENABLE_MACCATALYST=ON \
-DMOTIONSTUDIO_IPHONEOS_DEPLOYMENT_TARGET=18.0 \
-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
${@} \
-DCMAKE_ARCHIVE_OUTPUT_DIRECTORY=$GEN_XCODE_PROJEC_DIR/Products \
-DCMAKE_LIBRARY_OUTPUT_DIRECTORY=$GEN_XCODE_PROJEC_DIR/Products \
-DCMAKE_RUNTIME_OUTPUT_DIRECTORY=$GEN_XCODE_PROJEC_DIR/Products \
-S $PROJECT_DIR


# CMake 默认 shellPath=/bin/sh，不会读 ~/.zshenv，且 Xcode 会重写 PATH。
# 改成 zsh 后，生成的 Script-*.sh 为 #!/bin/zsh，exec 时加载 ~/.zshenv 并重建 PATH。
# （日志里仍可能显示 /bin/sh -c Script-xxx.sh，但 shebang 会转到 zsh。）
echo "[*] patch xcode script phases: shellPath /bin/sh -> /bin/zsh"
sed -i '' 's#shellPath = /bin/sh;#shellPath = /bin/zsh;#' "$GEN_XCODE_PROJEC_FILE"
echo "[*] Patch done."
