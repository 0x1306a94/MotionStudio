// Configuration settings file format documentation can be found at:
// https://developer.apple.com/documentation/xcode/adding-a-build-configuration-file-to-your-project


PRODUCT_BUNDLE_IDENTIFIER = com.0x1306a94.motionstudio
TEST_PRODUCT_BUNDLE_IDENTIFIER_PREFIX = $(PRODUCT_BUNDLE_IDENTIFIER)
MOTION_PROJECT_DOCUMENT_IDENTIFIER = com.0x1306a94.motionstudio.project
MOTION_PROJECT_DOCUMENT_EXTENSION = motionproject

// C++ core headers + C ABI bridge headers (imported via the bridging header).
HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT)/../../include $(SRCROOT)/../../bridge/include
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/MotionStudioApp/Bridge/MotionStudio-Bridging-Header.h

//OTHER_SWIFT_FLAGS = $(inherited) -Xcc -fmodule-map-file="$(SRCROOT)/AutoGenerated/MotionStudioBridging.modulemap"

// Static libraries built by apps/gen_mac into gen_xcode (per SDK).
// Mac destination is Mac Catalyst only — sdk=macosx* means ios-macabi (no native macOS).
// Include both Products/$(CONFIGURATION) and *-maccatalyst: CMake may use either layout.
LIBRARY_SEARCH_PATHS = $(inherited) $(SRCROOT)/../gen_xcode/Products/$(CONFIGURATION)
LIBRARY_SEARCH_PATHS[sdk=macosx*] = $(inherited) $(SRCROOT)/../gen_xcode/tgfx_prebuilt/$(CONFIGURATION)/catalyst/arm64
LIBRARY_SEARCH_PATHS[sdk=iphoneos*] = $(inherited) $(SRCROOT)/../gen_xcode/tgfx_prebuilt/$(CONFIGURATION)/ios/arm64
LIBRARY_SEARCH_PATHS[sdk=iphonesimulator*] = $(inherited) $(SRCROOT)/../gen_xcode/tgfx_prebuilt/$(CONFIGURATION)/ios/arm64-simulator

// Core + bridge + tgfx adapter + prebuilt tgfx, and their framework deps.
CORE_LINK_FLAGS = -lmotionstudio_bridge -lmotionstudio_core -lmotionstudio_tgfx_adapter -ltgfx -lc++ -liconv -framework Metal -framework MetalKit -framework Foundation -framework QuartzCore -framework CoreMedia -framework CoreVideo -framework ImageIO
OTHER_LDFLAGS = $(inherited) $(CORE_LINK_FLAGS)
OTHER_LDFLAGS[sdk=macosx*] = $(inherited) -framework UIKit -framework CoreGraphics
OTHER_LDFLAGS[sdk=iphoneos*] = $(inherited) -framework UIKit -framework CoreGraphics
OTHER_LDFLAGS[sdk=iphonesimulator*] = $(inherited) -framework UIKit -framework CoreGraphics

#include? "Developer.xcconfig"
